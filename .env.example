# ============================================================
# FLUIQ — Variables de entorno del backend
# ------------------------------------------------------------
# Copiá este archivo como referencia y cargá los valores reales
# en Netlify: Site settings -> Environment variables.
# NUNCA subas el archivo .env real al repositorio.
# ============================================================

# --- Email (Resend) — REQUERIDO para notificaciones ---
# Crear cuenta gratis en https://resend.com (3.000 emails/mes)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Destino de la notificación de cada lead
NOTIFY_EMAIL=santicelemink@gmail.com

# Remitente. Para empezar podés usar el dominio de prueba de Resend.
# En producción, verificá tu propio dominio y usá algo como:
#   FROM_EMAIL=FLUIQ <hola@fluiq.com>
FROM_EMAIL=FLUIQ <onboarding@resend.dev>

# --- Supabase (OPCIONAL) — para guardar los leads ---
# Project settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Usar la clave service_role (NO la anon). Se mantiene solo en el
# servidor; nunca se expone al navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxx

# --- CORS (OPCIONAL) ---
# Restringir a tu dominio real en producción, ej: https://fluiq.com
ALLOWED_ORIGIN=*
